{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "public",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "headers": [
    {
      "source": "/BoltAndNut.AppImage",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=BoltAndNut.AppImage"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/play/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dl",
      "destination": "/BoltAndNut.AppImage",
      "permanent": false
    },
    {
      "source": "/play",
      "destination": "/play/",
      "permanent": false
    },
    {
      "source": "/BoltAndNut-:version.AppImage",
      "destination": "/BoltAndNut.AppImage",
      "permanent": false
    }
  ]
}
