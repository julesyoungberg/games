{
  "redirects": [
    { "source": "/dl", "destination": "https://couch-coop-games.vercel.app/wick-and-shade/dl", "permanent": false },
    { "source": "/:file(.*\\.AppImage)", "destination": "https://couch-coop-games.vercel.app/wick-and-shade/:file", "permanent": false },
    { "source": "/icon.png", "destination": "https://couch-coop-games.vercel.app/wick-and-shade/icon.png", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
